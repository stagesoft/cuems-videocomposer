[Unit]
Description=CUEMS Video Composer (multi-layer video compositor)
Documentation=https://github.com/cuems/cuems-videocomposer
# Start after display and GPU/DRI are available
After=graphical.target
Wants=graphical.target
# Optional: wait for DRI device if udev tags it (dev-dri-card0.device)
# After=dev-dri-card0.device

[Service]
Type=simple
User=cuems
Group=cuems
# DRI/GPU access: video and render groups
SupplementaryGroups=video render
# Environment for GPU/display (adjust for your setup)
Environment=HOME=/var/lib/cuems
# Optional: disable splash when starting at boot to avoid blocking
# ExecStart=/usr/bin/cuems-videocomposer --no-splash
ExecStart=/usr/bin/cuems-videocomposer
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cuems-videocomposer

# DRI/ALSA: need access to device nodes (run with User=, SupplementaryGroups=video render)
PrivateTmp=yes
NoNewPrivileges=yes
# Do not use PrivateDevices so /dev/dri and /dev/snd are visible
PrivateDevices=no
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/cuems

[Install]
WantedBy=graphical.target
