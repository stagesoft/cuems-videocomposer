[Unit]
Description=CUEMS Video Composer (multi-layer video compositor)
Documentation=https://github.com/cuems/cuems-videocomposer
# Start after display and GPU/DRI are available
After=graphical.target
Wants=graphical.target
# Optional: wait for DRI device if udev tags it (dev-dri-card0.device)
# After=dev-dri-card0.device

[Service]
Type=simple
User=cuems
Group=cuems
# DRI/GPU access: video and render groups; audio for ALSA MIDI (/dev/snd/seq)
SupplementaryGroups=video render audio
# Environment for GPU/display (adjust for your setup)
Environment=HOME=/var/lib/cuems
# Generate display config from default_mappings.xml before starting
ExecStartPre=/usr/lib/cuems/bin/cuems-generate-display-conf
ExecStart=/usr/bin/cuems-videocomposer
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cuems-videocomposer

# DRI/ALSA: need access to device nodes (run with User=, SupplementaryGroups=video render audio)
PrivateTmp=yes
NoNewPrivileges=yes
# Do not use PrivateDevices so /dev/dri and /dev/snd are visible
PrivateDevices=no
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/cuems
RuntimeDirectory=cuems

[Install]
WantedBy=graphical.target
